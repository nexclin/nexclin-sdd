# === NexClin — variáveis de ambiente (exemplo) ===
# Copie para .env.local e preencha. NUNCA commite .env.local (constituição, Princípio V).
# Segredos vivem apenas no gerenciador de senhas.

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do projeto
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave administrativa — apenas scripts/server (seed), JAMAIS no cliente
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do operador Super Admin (usado pelo seed; senha definida via recovery)
SUPERADMIN_EMAIL=erpclinicas@gmail.com

# Chave do Resend (e-mails transacionais — a partir da SPEC 003)
RESEND_API_KEY=

# === e2e (SPEC 001 / T027) — só para rodar `npm run test:e2e` ===
#
# Sem estas variáveis a suíte roda mesmo assim: o bloco "sem sessão, tudo é
# negado" cobre 13 rotas e não precisa de login nenhum. Os blocos que exigem
# sessão PULAM com motivo explícito, em vez de passar vazios.
#
# Por que não há um seed que cria estes usuários com senha: a regra (e) da
# constituição proíbe qualquer caminho de código que defina senha, e o hook
# `guarda-constituicao` bloqueia `admin.createUser({ password })` na escrita do
# arquivo. A catraca vale também para usuário de teste, porque a exceção "só
# nesse caso" é exatamente como a regra morre.
#
# Como preencher, uma vez só:
#   1. T012 — defina a senha do superadmin por recovery no painel do Supabase.
#      Use essa senha em E2E_SUPERADMIN_SENHA.
#   2. Convide um usuário de teste pela tela de Equipe, com permissão PARCIAL
#      (deixe pelo menos um módulo negado — é ele que exercita o bloqueio de
#      rota). Abra o link do convite e defina a senha.
#   3. Preencha as quatro variáveis abaixo.
E2E_URL_BASE=http://localhost:3000
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_SENHA=
E2E_USUARIO_EMAIL=
E2E_USUARIO_SENHA=
